{
  "log": {
    "level": "info",
    "timestamp": true,
    "output": "/var/log/sing-box.log"
  },
  "dns": {
    "servers": [
      {
        "type": "udp",
        "tag": "dns-proxy",
        "server": "8.8.8.8",
        "detour": "PROXY"
      },
      {
        "type": "udp",
        "tag": "dns-local",
        "server": "223.5.5.5"
      },
      {
        "type": "fakeip",
        "tag": "dns-fake",
        "inet4_range": "198.18.0.0/15"
      }
    ],
    "rules": [
      {
        "rule_set": "geosite-cn",
        "server": "dns-local"
      },
      {
        "rule_set": "geosite-geolocation-!cn",
        "server": "dns-fake"
      }
    ],
    "final": "dns-local",
    "strategy": "ipv4_only"
  },
  "inbounds": [
    {
      "type": "tproxy",
      "tag": "tproxy-in",
      "listen": "::",
      "listen_port": 7895
    },
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 7890
    }
  ],
  "outbounds": [
    {
      "type": "anytls",
      "tag": "PROXY",
      "server": "REPLACE_WITH_YOUR_SERVER_IP_OR_DOMAIN",
      "server_port": 443,
      "password": "REPLACE_WITH_YOUR_PASSWORD",
      "domain_resolver": "dns-local",
      "tls": {
        "enabled": true,
        "server_name": "REPLACE_WITH_YOUR_SNI"
      }
    },
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "rules": [
      {
        "action": "sniff"
      },
      {
        "port": 53,
        "action": "hijack-dns"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "ip_is_private": true,
        "outbound": "direct"
      },
      {
        "domain_suffix": [".ts.net"],
        "outbound": "direct"
      },
      {
        "domain_suffix": ["REPLACE_WITH_YOUR_SERVER_DOMAIN"],
        "outbound": "direct"
      },
      {
        "rule_set": "geosite-cn",
        "outbound": "direct"
      },
      {
        "rule_set": "geosite-geolocation-!cn",
        "outbound": "PROXY"
      },
      {
        "rule_set": "geoip-cn",
        "outbound": "direct"
      },
      {
        "ip_cidr": ["::/0"],
        "action": "reject"
      }
    ],
    "final": "direct",
    "auto_detect_interface": true,
    "default_domain_resolver": {
      "server": "dns-local"
    },
    "rule_set": [
      {
        "type": "local",
        "tag": "geosite-cn",
        "format": "binary",
        "path": "/etc/sing-box/rules/geosite-cn.srs"
      },
      {
        "type": "local",
        "tag": "geosite-geolocation-!cn",
        "format": "binary",
        "path": "/etc/sing-box/rules/geosite-geolocation-!cn.srs"
      },
      {
        "type": "local",
        "tag": "geoip-cn",
        "format": "binary",
        "path": "/etc/sing-box/rules/geoip-cn.srs"
      }
    ]
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "path": "/tmp/sing-box-cache.db",
      "store_fakeip": true
    },
    "clash_api": {
      "external_controller": "0.0.0.0:9090",
      "secret": "",
      "default_mode": "Rule"
    }
  }
}
