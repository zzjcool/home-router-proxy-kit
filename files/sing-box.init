#!/bin/sh /etc/rc.common
# sing-box 服务 (procd) - GL.iNet GL-MT3600BE / OpenWrt 21.02

START=95
STOP=10
USE_PROCD=1

PROG="/usr/bin/sing-box"
CONF="/etc/sing-box/config.json"
WORKDIR="/etc/sing-box"

start_service() {
	[ -x "$PROG" ] || { echo "sing-box 未安装: $PROG"; return 1; }
	if ! "$PROG" check -c "$CONF" >/dev/null 2>&1; then
		echo "配置校验失败, 拒绝启动:"
		"$PROG" check -c "$CONF"
		return 1
	fi
	procd_open_instance
	procd_set_param command "$PROG" run -c "$CONF" -D "$WORKDIR"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits nofile="8192 8192"
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "sing-box"
}
